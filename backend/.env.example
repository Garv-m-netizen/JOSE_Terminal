# --- AI provider (Gemini). Leave GEMINI_API_KEY empty to run in explicit DEMO mode. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto = real when GEMINI_API_KEY is set, otherwise demo. Or force: real | demo
JOSE_MODE=auto

# --- Web search: duckduckgo (no key, best effort) | tavily | brave | none ---
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Execution limits ---
MAX_RETRIES=2
MAX_PARALLEL_TASKS=3
HTTP_TIMEOUT_SECONDS=20
TASK_TIMEOUT_SECONDS=240
MAX_UPLOAD_MB=10

# --- Browser (Playwright). Run `python -m playwright install chromium` once. ---
BROWSER_ENABLED=true
BROWSER_HEADLESS=true

# --- Approval policy: auto-approve MEDIUM risk actions in Autonomous mode ---
AUTO_APPROVE_MEDIUM=false

# --- Storage (relative paths are resolved against backend/) ---
DATABASE_URL=sqlite:///./data/jose.db
OUTPUT_DIR=./data/outputs
UPLOAD_DIR=./data/uploads

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Telegram (for the test-paper workflow). Create a bot with @BotFather, add it to the group
# as a member, then put the group's chat id here (negative number such as -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fallback LLM (Groq). If Gemini fails (quota, outage, invalid output) JOSE retries the same call on Groq.
# With only a Groq key set, Groq is used on its own. Get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (SMTP). Required by the email.draft / email.send tools. For Gmail use smtp.gmail.com:587 with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM=
# The literal recipient "configured" resolves to this address. Other recipients must be written in the objective
# or listed in EMAIL_ALLOWED_RECIPIENTS (comma separated addresses or @domain entries).
EMAIL_DEFAULT_RECIPIENT=
EMAIL_ALLOWED_RECIPIENTS=

# --- Filesystem sandbox: directories the fs.* tools may read/copy/move within (os.pathsep separated; ';' on Windows).
# Default is backend/data/workspace.
WORKSPACE_DIRS=
